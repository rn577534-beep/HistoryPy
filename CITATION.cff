cff-version: 1.2.0
message: "If you use HistoryPy in your research, please cite it using this metadata."
title: "HistoryPy"
type: software
version: "1.0.0"
abstract: >-
  An evidence-aware Python toolkit for historical research and analysis.
  HistoryPy supports provenance-aware datasets, source-dependence audits,
  multilingual entity aliases, hybrid retrieval, and reviewable relationship
  path exploration without automatically asserting historical truth.
authors:
  - name: "HistoryPy contributors"
repository-code: "https://github.com/rn577534-beep/HistoryPy"
url: "https://github.com/rn577534-beep/HistoryPy"
license: MIT
